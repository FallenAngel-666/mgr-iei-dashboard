# ==============================================================================
# IEI MGR STUDENTS CHAPTER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (development) or .env.production (production build)
# NEVER commit real API keys, passwords, or service account secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Mode & Production Custom Domain
# ------------------------------------------------------------------------------
# Use "hostinger" for 100% Hostinger MySQL Database + Hostinger File Storage (PHP 8 API)
# Use "firebase" only if running on Firebase Hosting / Cloud Firestore
VITE_BACKEND_MODE=hostinger
VITE_API_BASE_URL=/api

# Leave blank to auto-detect via window.location.origin, or set your custom HTTPS URL:
# Example: https://your-custom-domain.com (no trailing slash)
VITE_APP_URL=
VITE_APP_ENV=production

# ------------------------------------------------------------------------------
# 2. Observability & Error Logging
# ------------------------------------------------------------------------------
# Records unhandled client runtime errors into the immutable audit stream
VITE_ENABLE_ERROR_LOGGING=true

# ------------------------------------------------------------------------------
# 3. Firebase Configuration (OPTIONAL — NOT needed when VITE_BACKEND_MODE=hostinger)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:000000000000:web:your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
