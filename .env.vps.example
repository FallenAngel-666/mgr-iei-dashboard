# ==============================================================================
# IEI MGR STUDENT CHAPTER — HOSTINGER KVM 2 VPS ENVIRONMENT CONFIGURATION
# Copy to .env and configure with your production credentials on the VPS
# ==============================================================================

# Server Network & Runtime
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Application Domain & Secrets
APP_URL=https://yourdomain.com
APP_SECRET=replace_with_64_char_secure_random_hex_secret
WAITING_ROOM_SECRET=replace_with_64_char_secure_random_hex_secret

# MySQL Database (Hostinger VPS Local MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iei_mgr_platform
DB_USER=iei_db_user
DB_PASSWORD=replace_with_strong_mysql_password
DB_CONNECTION_LIMIT=50
DB_QUEUE_LIMIT=100

# Redis 7 (In-Memory Sliding-Window Rate Limiting & Waiting Room Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# Traffic Engine & Capacity Controls
MAX_ACTIVE_SESSIONS=350
OFFICER_RESERVE_SLOTS=35
ADMISSION_BATCH_SIZE=20
ADMISSION_INTERVAL_MS=5000
SESSION_TTL_SECONDS=900

# CORS Whitelist
ALLOWED_ORIGINS=https://yourdomain.com,https://mgr-iei-dashboard.vercel.app
