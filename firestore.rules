rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Institutional role validation
    function isValidRole(role) {
      return role in [
        'Administrator',
        'Staff Coordinator',
        'Chairman',
        'Vice Chairman',
        'Secretary',
        'Joint Secretary',
        'Treasurer',
        'Joint Treasurer',
        'Membership Director',
        'Event Management Head',
        'Executive Member'
      ];
    }

    function isValidTaskStatus(status) {
      return status in [
        'Assigned',
        'In Progress',
        'Submitted',
        'Pending First-Level Approval',
        'Pending Final Approval',
        'Rejected',
        'Completed'
      ];
    }

    // 1. SYSTEM ACTIVITY CONSOLE: IMMUTABLE AUDIT LOGS
    match /system_audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.action != null && 
                       request.resource.data.status in ['SUCCESS', 'FAILED', 'DENIED'];
      // ABSOLUTE IMMUTABILITY: Never allow update or delete under any circumstances
      allow update: if false;
      allow delete: if false;
    }

    // 2. PUBLIC WELCOME PAGE PROFILE
    match /iei_public_profile/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. PUBLIC UPCOMING EVENTS & POSTERS
    match /iei_public_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. MEMBERS DIRECTORY & USER PROFILES
    match /iei_members/{memberId} {
      allow read: if true;
      allow create, update: if request.resource.data.name != null &&
                               request.resource.data.role != null;
      allow delete: if true;
    }

    match /iei_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. WORK TASKS & SUBMISSIONS
    match /iei_tasks/{taskId} {
      allow read: if true;
      allow create: if request.resource.data.title != null && 
                       isValidTaskStatus(request.resource.data.status);
      allow update: if isValidTaskStatus(request.resource.data.status);
      allow delete: if true;
    }

    // 6. COMMUNITY WORK UPDATES & MESSAGES
    match /iei_updates/{updateId} {
      allow read: if true;
      allow create: if request.resource.data.content != null;
      allow update: if true;
      allow delete: if true;
    }

    // 7. CHAPTER EVENTS & MEETINGS
    match /iei_events/{eventId} {
      allow read: if true;
      allow create, update: if request.resource.data.title != null && 
                               request.resource.data.date != null;
      allow delete: if true;
    }

    // 8. ATTENDANCE REGISTERS
    match /iei_attendance/{attId} {
      allow read: if true;
      allow create, update: if request.resource.data.eventId != null && 
                               request.resource.data.date != null;
      allow delete: if true;
    }

    // 9. CIRCULARS & ANNOUNCEMENTS
    match /iei_announcements/{annId} {
      allow read: if true;
      allow create, update: if request.resource.data.title != null && 
                               request.resource.data.content != null;
      allow delete: if true;
    }

    // 10. CERTIFICATES & ACHIEVEMENTS
    match /iei_certificates/{certId} {
      allow read: if true;
      allow write: if true;
    }

    match /iei_achievements/{achId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. CHAPTER NOTIFICATIONS
    match /iei_notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
